@model PortfolioViewModel
@{
    var isEnglish = Model.Language == "en";
    string T(string spanish, string english) => isEnglish ? english : spanish;
    ViewData["Language"] = Model.Language;
    ViewData["Title"] = T("Desarrollador .NET", ".NET Developer");
}

<section class="hero" id="inicio">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-kicker reveal">
        <span class="signal-dot"></span>
        @T("Santo Domingo, República Dominicana", "Santo Domingo, Dominican Republic")
    </div>
    <div class="hero-copy reveal">
        <p class="hero-index">@T("BIENVENIDO A MI MUNDO", "WELCOME TO MY WORLD")</p>
        <h1>
            @T("Desarrollo software", "I build software")<br />
            <span>@T("con intención.", "with purpose.")</span>
        </h1>
        <p class="hero-lead">
            @T("Soy", "I'm") <strong>Alexander Díaz Ramírez</strong>, @T("desarrollador de software junior y estudiante de término de Ingeniería en Software. Construyo aplicaciones con C#, .NET y SQL Server.", "a junior software developer and final-year Software Engineering student. I build applications with C#, .NET, and SQL Server.")
        </p>
        <div class="hero-actions">
            <a class="button button-primary" href="#proyectos">@T("Explorar proyectos", "Explore projects") <span aria-hidden="true">↘</span></a>
            <a class="button button-quiet" href="mailto:alexanderadr1298@gmail.com">@T("Hablemos", "Let's talk")</a>
        </div>
    </div>
    <div class="hero-stamp reveal" aria-label="@T("Monograma de Alexander Díaz", "Alexander Díaz monogram")">
        <span>AD</span>
        <small>SOFTWARE<br />DEVELOPER</small>
    </div>
    <div class="hero-foot reveal">
        <span>@T("Disponible para oportunidades junior .NET", "Open to junior .NET opportunities")</span>
        <span class="hero-scroll">@T("Desliza para conocer mi trabajo", "Scroll to explore my work") ↓</span>
    </div>
</section>

<section class="now-strip reveal" aria-label="@T("Trabajo actual", "Current role")">
    <div class="section-number">00</div>
    <div>
        <p class="eyebrow">@T("Actualmente", "Currently")</p>
        <h2>@T("Construyendo GoGo Delivery RD", "Building GoGo Delivery RD")</h2>
    </div>
    <p>@T("Trabajo junto a un equipo en una aplicación Flutter para comercios del ecosistema de pedidos de GOGO DELIVERY RD, bajo contrato por proyecto y de forma remota.", "I work remotely with a team on a Flutter application for merchants in the GOGO DELIVERY RD ordering ecosystem, under a project-based contract.")</p>
    <span class="status-pill"><span></span> @T("En desarrollo", "In development")</span>
</section>

<section class="section projects-section" id="proyectos">
    <header class="section-heading reveal">
        <div>
            <p class="eyebrow">@T("Trabajo seleccionado", "Selected work")</p>
            <h2>@T("Proyectos que cuentan mi proceso.", "Projects that tell my story.")</h2>
        </div>
        <p>@T("No son tarjetas de relleno: cada proyecto muestra una etapa distinta de mi crecimiento como desarrollador.", "These are not filler cards: each project represents a different stage of my growth as a developer.")</p>
    </header>

    <div class="project-list">
        @foreach (var project in Model.Projects)
        {
            <article class="project reveal">
                <div class="project-number">@project.Number</div>
                <div class="project-main">
                    <p class="eyebrow">@project.Eyebrow</p>
                    <h3>@project.Title</h3>
                    <p class="project-description">@project.Description</p>
                    @if (project.Technologies.Count > 0)
                    {
                        <ul class="tag-list" aria-label="@T("Tecnologías utilizadas", "Technologies used")">
                            @foreach (var technology in project.Technologies)
                            {
                                <li>@technology</li>
                            }
                        </ul>
                    }
                    @if (project.ImageUrl is not null)
                    {
                        <figure class="project-preview project-preview--@project.ImageVariant">
                            <div class="device-shell device-shell--@project.ImageVariant">
                                <img src="@project.ImageUrl" alt="@project.ImageAlt" loading="lazy" />
                            </div>
                            <figcaption>
                                <span>@(project.ImageHeading ?? T("Vista del producto", "Product view"))</span>
                                @project.ImageCaption
                            </figcaption>
                        </figure>
                    }
                </div>
                <div class="project-meta">
                    <span class="project-status">@project.Status</span>
                    @if (project.Url is not null)
                    {
                        <a href="@project.Url" target="_blank" rel="noreferrer">@project.LinkLabel <span aria-hidden="true">↗</span></a>
                    }
                    else
                    {
                        <span class="project-link-muted">@project.LinkLabel</span>
                    }
                </div>
            </article>
        }
    </div>
</section>

<section class="section split-section" id="experiencia">
    <header class="section-heading reveal">
        <div>
            <p class="eyebrow">@T("Trayectoria", "Career")</p>
            <h2>@T("Experiencia construida haciendo.", "Experience built by doing.")</h2>
        </div>
    </header>

    <div class="timeline">
        <article class="timeline-item reveal">
            <div class="timeline-date">@T("Actual", "Current")</div>
            <div>
                <p class="eyebrow">@T("Remoto · Contrato por proyecto", "Remote · Project-based contract")</p>
                <h3>@T("Desarrollador Junior", "Junior Developer") · GoGo Delivery RD</h3>
                <p>@T("Desarrollo en equipo de una aplicación Flutter para comercios, con integración a la API central y flujos móviles de acceso y verificación.", "Team development of a Flutter application for merchants, with central API integration and mobile access and verification flows.")</p>
            </div>
        </article>
        <article class="timeline-item reveal">
            <div class="timeline-date">@T("6–12 meses", "6–12 months")</div>
            <div>
                <p class="eyebrow">@T("Remoto · Independiente", "Remote · Independent")</p>
                <h3>@T("Desarrollador Freelance", "Freelance Developer")</h3>
                <p>@T("Sistemas web a la medida con ASP.NET Core MVC, arquitectura por capas, CRUD y bases de datos SQL Server. Participación desde el levantamiento de requerimientos hasta la entrega.", "Custom web systems built with ASP.NET Core MVC, layered architecture, CRUD operations, and SQL Server databases. Involved from requirements gathering through delivery.")</p>
            </div>
        </article>
        <article class="timeline-item reveal">
            <div class="timeline-date">UFHEC</div>
            <div>
                <p class="eyebrow">@T("Pasantía", "Internship")</p>
                <h3>@T("Biblioteca Universitaria", "University Library")</h3>
                <p>@T("Gestión documental, clasificación de recursos y atención al usuario.", "Document management, resource classification, and user support.")</p>
            </div>
        </article>
        <article class="timeline-item reveal">
            <div class="timeline-date">@T("Eventos", "Events")</div>
            <div>
                <p class="eyebrow">@T("Colaboración", "Collaboration")</p>
                <h3>@T("Animación y logística", "Entertainment and logistics")</h3>
                <p>@T("Apoyo en la organización y desarrollo de eventos sociales.", "Support in organizing and running social events.")</p>
            </div>
        </article>
    </div>
</section>

<section class="section skills-section" id="habilidades">
    <header class="section-heading reveal">
        <div>
            <p class="eyebrow">@T("Herramientas", "Tools")</p>
            <h2>@T("Mi stack, sin exageraciones.", "My stack, no exaggerations.")</h2>
        </div>
        <p>@T("Backend .NET como base, acompañado por desarrollo móvil, bases de datos e integración de IA local.", ".NET backend as my foundation, complemented by mobile development, databases, and local AI integration.")</p>
    </header>

    <div class="skills-map">
        <article class="skill-block skill-core reveal">
            <span class="skill-code">CORE / 01</span>
            <h3>Backend</h3>
            <p>@T("C#, ASP.NET Core MVC, diseño y consumo de APIs, Windows Forms", "C#, ASP.NET Core MVC, API design and consumption, Windows Forms")</p>
        </article>
        <article class="skill-block reveal">
            <span class="skill-code">DATA / 02</span>
            <h3>@T("Datos", "Data")</h3>
            <p>@T("SQL Server, Entity Framework, Code First y migraciones", "SQL Server, Entity Framework, Code First, and migrations")</p>
        </article>
        <article class="skill-block reveal">
            <span class="skill-code">MOBILE / 03</span>
            <h3>@T("Móvil", "Mobile")</h3>
            <p>@T(".NET MAUI, MVVM y Shell navigation · Flutter básico aplicado en un proyecto de equipo", ".NET MAUI, MVVM, and Shell navigation · Basic Flutter applied in a team project")</p>
        </article>
        <article class="skill-block reveal">
            <span class="skill-code">AI / 04</span>
            <h3>@T("IA aplicada", "Applied AI")</h3>
            <p>@T("Integración de LLMs con Ollama y prompt engineering", "LLM integration with Ollama and prompt engineering")</p>
        </article>
        <article class="skill-block reveal">
            <span class="skill-code">WEB / 05</span>
            <h3>Frontend</h3>
            <p>@T("HTML, CSS y JavaScript · nociones prácticas", "HTML, CSS, and JavaScript · practical fundamentals")</p>
        </article>
        <article class="skill-block reveal">
            <span class="skill-code">OPS / 06</span>
            <h3>@T("Herramientas", "Tools")</h3>
            <p>@T("Git, GitHub, Bash, pruebas con xUnit y Docker básico", "Git, GitHub, Bash, xUnit testing, and basic Docker")</p>
        </article>
    </div>
</section>

