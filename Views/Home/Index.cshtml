    <header class="section-heading reveal">
        <div>
            <p class="eyebrow">@T("Formación continua", "Continuous learning")</p>
            <h2>@T("Lo que aprendo, lo pongo a trabajar.", "I put what I learn to work.")</h2>
        </div>
        <p>@T("Cursos técnicos y formación complementaria que respaldan mi crecimiento como desarrollador.", "Technical courses and complementary training that support my growth as a developer.")</p>
