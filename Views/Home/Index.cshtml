    <div class="contact-grid reveal">
        <h2>¿Construimos algo<br /><span>que funcione de verdad?</span></h2>
        <div class="contact-links">
            <a href="mailto:alexanderadr1298@gmail.com">alexanderadr1298@gmail.com <span aria-hidden="true">↗</span></a>
            <a href="https://github.com/AlexanderDiazRz" target="_blank" rel="noreferrer">github.com/AlexanderDiazRz <span aria-hidden="true">↗</span></a>
            <p>Santo Domingo, República Dominicana</p>
        </div>
    </div>
</section>
