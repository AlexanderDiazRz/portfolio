    </header>

    <div class="learning-grid">
        <article class="course-card reveal">
            <span class="course-number" aria-hidden="true">01</span>
            <p class="course-area">Desarrollo backend</p>
            <h3>Programando en C#: de principiante a profesional</h3>
            <div class="course-meta">
                <span>Udemy</span>
                <span>Completado</span>
            </div>
        </article>
        <article class="course-card reveal">
            <span class="course-number" aria-hidden="true">02</span>
            <p class="course-area">Formación complementaria</p>
            <h3>Inglés Intensivo 5</h3>
            <div class="course-meta">
                <span>ITLA</span>
                <span>Completado</span>
            </div>
        </article>
        <article class="course-card reveal">
            <span class="course-number" aria-hidden="true">03</span>
            <p class="course-area">Control de versiones</p>
            <h3>Git</h3>
            <div class="course-meta">
                <span>Código Facilito</span>
                <span>Completado</span>
            </div>
        </article>
        <article class="course-card reveal">
            <span class="course-number" aria-hidden="true">04</span>
            <p class="course-area">Metodologías ágiles</p>
            <h3>Fundamentos de Scrum</h3>
            <div class="course-meta">
                <span>Formación</span>
                <span>Completado</span>
            </div>
        </article>
    </div>
</section>

<section class="section about-section" id="sobre-mi">
