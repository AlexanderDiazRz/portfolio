            <div class="course-meta">
                <span>Udemy</span>
                <span>@T("Completado", "Completed")</span>
            </div>
        </article>
        <article class="course-card reveal">
            <span class="course-number" aria-hidden="true">02</span>
            <p class="course-area">@T("Formación complementaria", "Complementary training")</p>
            <h3>Inglés Intensivo 5</h3>
            <div class="course-meta">
                <span>ITLA</span>
                <span>@T("Completado", "Completed")</span>
            </div>
        </article>
        <article class="course-card reveal">
            <span class="course-number" aria-hidden="true">03</span>
            <p class="course-area">@T("Control de versiones", "Version control")</p>
            <h3>Git</h3>
            <div class="course-meta">
                <span>Código Facilito</span>
                <span>@T("Completado", "Completed")</span>
            </div>
        </article>
        <article class="course-card reveal">
            <span class="course-number" aria-hidden="true">04</span>
            <p class="course-area">@T("Metodologías ágiles", "Agile methodologies")</p>
            <h3>@T("Fundamentos de Scrum", "Scrum Fundamentals")</h3>
            <div class="course-meta">
                <span>@T("Formación", "Training")</span>
                <span>@T("Completado", "Completed")</span>
            </div>
        </article>
    </div>
</section>

<section class="section about-section" id="sobre-mi">
    <div class="about-mark reveal" aria-hidden="true">A/D</div>
    <div class="about-copy reveal">
        <p class="eyebrow">@T("Sobre mí", "About me")</p>
        <h2>@T("Aprendo construyendo soluciones reales.", "I learn by building real solutions.")</h2>
        <p>@T("Soy estudiante de término de Ingeniería en Software en la Universidad Federico Henríquez y Carvajal. Me interesa seguir creciendo como desarrollador .NET, trabajar en equipo y convertir necesidades concretas en aplicaciones claras y útiles.", "I am a final-year Software Engineering student at Universidad Federico Henríquez y Carvajal. I want to continue growing as a .NET developer, collaborate with teams, and turn concrete needs into clear, useful applications.")</p>
        <div class="education-note">
            <span>@T("Educación", "Education")</span>
            <strong>@T("Ingeniería en Software", "Software Engineering") · UFHEC</strong>
            <small>@T("Estudiante de término", "Final-year student")</small>
        </div>
    </div>
</section>

